{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "requirement": {
        "sidecar": "binaries/ffmpeg"
      }
    }
  ]
}